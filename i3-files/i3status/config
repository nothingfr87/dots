general {
    colors = true
    interval = 1
    color_good = "#a6e3a1"
    color_degraded = "#f9e2af"
    color_bad = "#f38ba8"
}

order += "volume master"
order += "tz local"
order += "cpu_usage"
order += "memory"
order += "tztime local"

tztime local {
    format = "%I:%m %p"
}

volume master {
    format = "VOL: %volume"
    format_muted = "VOL: muted (%volume)"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

cpu_usage {
    format = "CPU: %usage"
    degraded_threshold = 40
    max_threshold = 90
}

memory {
    format = "RAM: %used / %total"
    threshold_degraded = "10%"
    format_degraded = "MEMORY: %free"
}

