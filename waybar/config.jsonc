{
  "width": 1024,
  "modules-left": ["niri/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "niri/language", "network"],

  "niri/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{}",
  },

  "clock": {
    "timezone": "Africa/Cairo",
    "format": "󰥔  {:%I:%M %p}",
    "format-alt": "  {:%d/%m/%Y}",
  },

  "network": {
    "format-ethernet": "  Connected",
    "format-wifi": "{icon} ({signalStrength}%)",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-disconnected": "⚠ Disconnected",
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "  Muted",
    "format-icons": {
      "default": ["", "", ""],
      "muted": "",
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
  },

  "niri/language": {
    "format": "  {short}",
  },
}
