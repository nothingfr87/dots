{
  "width": 1024,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": ["clock", "custom/media"],
  "modules-center": ["niri/workspaces"],
  "modules-right": ["network", "pulseaudio", "custom/distro"],

  "custom/media": {
    "format": "{icon} {text}",
    "return-type": "json",
    "max-length": 40,
    "format-icons": {
      "spotify": "",
      "default": "🎜",
    },
    "escape": true,
    "on-click": "playerctl play-pause",
    "exec": "~/.config/waybar/custom_modules/mediaplayer.py 2>/dev/null",
  },

  "niri/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{}",
    "tooltip": false,
  },

  "custom/distro": {
    "format": "",
    "on-click": "wofi --show drun",
    "tooltip": false,
  },

  "network": {
    "format-ethernet": " ",
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-disconnected": "⚠",
    "tooltip": false,
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""],
      "muted": "",
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": false,
  },

  "clock": {
    "timezone": "Africa/Cairo",
    "format": "{:%I:%M %p}",
    "format-alt": "{:%d/%m/%Y}",
    "tooltip": false,
  },
}
