{
  "modules-left": ["clock"],
  "modules-center": ["niri/workspaces", "sway/workspaces"],
  "modules-right": ["network", "pulseaudio", "custom/power"],

  "niri/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "",
    "tooltip": false,
  },

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{}",
    "tooltip": false,
  },

  "custom/power": {
    "format": "⏻  Shutdown",
    "on-click": "systemctl poweroff",
    "tooltip": false,
  },

  "network": {
    "format-ethernet": "  Connected",
    "format-wifi": "{icon}  ({signalStrength}%)",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-disconnected": "⚠ Disconnected",
    "tooltip": false,
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "  Muted",
    "format-icons": {
      "default": ["", "", ""],
      "muted": "",
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": false,
  },

  "clock": {
    "timezone": "Africa/Cairo",
    "format": "󰥔  {:%I:%M %p}",
    "format-alt": "  {:%d/%m/%Y}",
    "tooltip": false,
  },
}
