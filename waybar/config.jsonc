{
  "height": 30,
  "modules-left": ["niri/workspaces"],

  "modules-center": [],

  "modules-right": [
    "pulseaudio",
    "custom/separator",
    "niri/language",
    "custom/separator",
    "network",
    "custom/separator",
    "clock",
  ],

  "custom/separator": {
    "format": "|",
    "interval": "once",
    "tooltip": false,
  },

  "niri/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{}",
  },

  "clock": {
    "timezone": "Africa/Cairo",
    "format": "{:%I:%M %p}",
  },

  //"cpu": {
  //  "format": "  {usage}%",
  //  "tooltip": false
  //},

  //"memory": {
  //  "format": "  {}%"
  //},

  "network": {
    "format-ethernet": "  Connected",
    "format-wifi": "{icon} ({signalStrength}%)",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-disconnected": "⚠ Disconnected",
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "  Muted",
    "format-icons": {
      "default": ["", "", ""],
      "muted": "",
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
  },

  //"custom/media": {
  //  "format": "{icon} {text}",
  //  "return-type": "json",
  //  "max-length": 40,
  //  "format-icons": {
  //    "spotify": "",
  //    "default": "🎜"
  //  },
  //  "escape": true,
  //  "on-click": "playerctl play-pause",
  //  "exec": "/home/nothing/.config/waybar/custom_modules/mediaplayer.py 2> /dev/null"
  //},

  "niri/language": {
    "format": "  {short}",
  },

  //"custom/run": {
  //  "format": " 󰍜 Menu",
  //  "on-click": "wofi --show drun"
  //}
}
