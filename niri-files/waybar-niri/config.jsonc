{
  "width": 1024,
  "modules-left": ["sway/workspaces", "niri/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "pulseaudio",
    "sway/language",
    "niri/language",
    "network",
    "custom/distro",
  ],

  "niri/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{}",
  },

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{}",
  },

  "clock": {
    "timezone": "Africa/Cairo",
    "format": "󰥔  {:%I:%M %p}",
    "format-alt": "  {:%d/%m/%Y}",
  },

  "network": {
    "format-ethernet": "  Connected",
    "format-wifi": "{icon} ({signalStrength}%)",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-disconnected": "⚠ Disconnected",
  },

  "custom/distro": {
    "format": "",
    "on-click": "wofi --show drun",
    "tooltip": false,
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "  Muted",
    "format-icons": {
      "default": ["", "", ""],
      "muted": "",
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
  },

  "niri/language": {
    "format": "  {short}",
  },
  "sway/language": {
    "format": "  {short}",
  },
}
